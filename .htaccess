# Для хостинга на Apache (Рег.ру). На GitHub Pages игнорируется.
# Редирект на HTTPS выключен. Включите его (уберите # в строках ниже) ТОЛЬКО после выпуска SSL-сертификата в панели хостинга.
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://wovlex.ru%{REQUEST_URI} [L,R=301]
# RewriteCond %{HTTP_HOST} ^www\.wovlex\.ru$ [NC]
# RewriteRule ^ https://wovlex.ru%{REQUEST_URI} [L,R=301]

ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
